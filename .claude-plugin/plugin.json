{
  "name": "semantic-diff-weaver",
  "version": "0.9.0",
  "description": "Analyze committed Git diffs and produce evidence-backed, risk-ranked test obligations. Read-only.",
  "author": {
    "name": "Semantic Diff Weaver contributors"
  },
  "homepage": "https://github.com/sergiparpal/semantic-diff-weaver",
  "repository": "https://github.com/sergiparpal/semantic-diff-weaver",
  "license": "MIT",
  "keywords": [
    "git",
    "diff",
    "testing",
    "code-review",
    "python"
  ],
  "mcpServers": {
    "semantic-diff-weaver": {
      "command": "uvx",
      "args": [
        "--from",
        "${CLAUDE_PLUGIN_ROOT}",
        "semantic-diff-weaver-mcp"
      ]
    }
  }
}
